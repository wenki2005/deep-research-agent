# Choose the model provider: "openai" (cloud) or "local" (Ollama, no API key needed)
RESEARCH_PROVIDER=local

# --- OpenAI mode (cloud) ----------------------------------------------------
# Get a key at https://platform.openai.com/api-keys and paste it here:
OPENAI_API_KEY=
# Optional: override the default OpenAI model
# OPENAI_MODEL=

# --- Local mode (Ollama) -----------------------------------------------------
# Install Ollama (https://ollama.com) and pull a model, e.g.:
#   ollama pull qwen3:4b
LOCAL_MODEL=qwen3:4b
# LOCAL_BASE_URL=http://127.0.0.1:11434/v1

# --- 任意 OpenAI 兼容端点（如 DeepSeek / GLM / Moonshot）---
# 设置后 openai 模式会直连该端点，需要同时指定模型名：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# 向量记忆嵌入模型（Ollama）
EMBED_MODEL=nomic-embed-text

# 搜索质量优化（强烈推荐，免费）：https://tavily.com
TAVILY_API_KEY=
